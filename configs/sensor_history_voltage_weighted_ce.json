{
  "seed": 42,
  "mode": "sensor_only",
  "sensor_features": [
    "meas_v",
    "meas_a",
    "meas_t1",
    "meas_t2",
    "meas_p",
    "meas_v_mean30s",
    "meas_v_delta30s"
  ],
  "sensor_imputation": "median",
  "sensor_scaling": "standard",
  "image_size": 128,
  "batch_size": 32,
  "epochs": 10,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "num_workers": 0,
  "sensor_hidden": 32,
  "fusion_hidden": 64,
  "dropout": 0.1,
  "loss": "weighted_cross_entropy",
  "sampling": "shuffle",
  "class_weight_power": 0.5,
  "focal_gamma": 2.0
}
